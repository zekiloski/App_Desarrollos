# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="mysql://root:TU_CONTRASEÑA@localhost:3306/nuevos_desarrollos"

# Clave para firmar las sesiones. Generar una distinta en producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Carpeta donde se guardan fotos y adjuntos (fuera de /public)
STORAGE_DIR="./storage"

# Zona horaria para mostrar fechas
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# URL publica de la app: es la que se graba en los codigos QR de las etiquetas
APP_URL="https://desarrollos.midominio.com"

# Envio de emails (en Hostinger: smtp.hostinger.com, puerto 465, usuario = la casilla completa).
# Sin estos datos los avisos quedan guardados como pendientes y no se envian.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nuevos Desarrollos <avisos@midominio.com>"

# Clave de la tarea diaria (resumen de piezas detenidas). Vacia = tarea desactivada.
# Cron job del hosting, una vez por dia: https://desarrollos.midominio.com/api/cron/diario?clave=LA_CLAVE
CRON_SECRET=""
